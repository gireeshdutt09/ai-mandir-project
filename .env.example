# Server Port
PORT=5000

# Optional Supabase Integration (PostgreSQL Database)
# Create a free project at https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Optional Google Maps / Mapbox Key (Leaflet works out-of-the-box with OpenStreetMap Voyager tiles)
VITE_MAP_TILES=voyager
